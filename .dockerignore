# Every service in docker/docker-compose.yml builds with `context: ..` (the
# repo root), so without this file the whole repo -- ~4.5GB including .venv/,
# the real PlantVillage dataset under data/, outputs/ and .git/ -- would be
# tarred and shipped to the Docker daemon on every build.
#
# Nothing listed here is needed inside any image: the three Dockerfiles only
# COPY src/ and docker/<service>/*.py|requirements.txt, and data/outputs/
# config.yaml reach the containers via runtime bind mounts, not COPY.
.venv/
.venv-nncase/
.git/
data/
outputs/
docs/
notebooks/
pi/
tests/
__pycache__/
.pytest_cache/
.superpowers/
